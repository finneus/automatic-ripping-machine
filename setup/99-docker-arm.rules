# Start ARM when a disc is inserted (Docker image).
#
# The file must sort after 60-cdrom_id.rules: that rule sets ID_CDROM_MEDIA and
# ID_CDROM_MEDIA_STATE. As 51-docker-arm.rules these were always unset when the
# match was evaluated, so every "change" event started a job - opening the tray,
# ejecting after a rip and repeated events for the same disc.
#
# - DISK_EJECT_REQUEST=1 comes from the kernel when the eject button is pressed
# - ID_CDROM_MEDIA=1 only when cdrom_id found a disc in the drive
# - sr[0-9]* also matches sr10 and above
#
# ID_CDROM_MEDIA_BD = Bluray
# ID_CDROM_MEDIA_DVD = DVD
# ID_CDROM_MEDIA_CD = CD
KERNEL=="sr[0-9]*", ACTION=="change", SUBSYSTEM=="block", ENV{DISK_EJECT_REQUEST}!="1", ENV{ID_CDROM_MEDIA}=="1", ENV{ID_CDROM_MEDIA_STATE}!="blank", RUN+="/sbin/setuser arm /opt/arm/scripts/docker/docker_arm_wrapper.sh %k"
